<!-- pages/teacher/login/login.wxml -->
<view class="container">
  <view class="card">
    <view class="title">🔐 教师登录</view>
    <input class="input" placeholder="邮箱" value="{{email}}" bindinput="onEmail" />
    <input class="input" placeholder="密码" password value="{{password}}" bindinput="onPwd" />
    <button class="btn" bindtap="onLogin" loading="{{loading}}">登录</button>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
