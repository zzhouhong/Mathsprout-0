.container { padding:100rpx 40rpx; }
.card { background:#fff; border-radius:24rpx; padding:60rpx 40rpx; text-align:center; box-shadow:0 4rpx 24rpx rgba(0,0,0,0.06); }
.title { font-size:36rpx; font-weight:700; margin-bottom:40rpx; }
.input { width:100%; height:88rpx; border:2rpx solid #E2E8F0; border-radius:16rpx; padding:0 24rpx; font-size:30rpx; margin-bottom:20rpx; box-sizing:border-box; }
.btn { width:100%; height:88rpx; background:#4F46E5; color:#fff; border-radius:16rpx; font-size:30rpx; margin-top:16rpx; }
.error { color:#EF4444; font-size:26rpx; margin-top:16rpx; }
