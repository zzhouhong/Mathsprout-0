.container { padding:40rpx; }
.header { font-size:36rpx; font-weight:700; margin-bottom:32rpx; }

.field { background:#fff; border-radius:16rpx; padding:24rpx; margin-bottom:24rpx; }
.label { font-size:28rpx; color:#64748B; display:block; margin-bottom:16rpx; }
.picker-value { font-size:30rpx; color:#1E293B; }

.dim-grid { display:flex; flex-wrap:wrap; gap:16rpx; }
.dim-chip {
  padding:12rpx 28rpx; border-radius:32rpx;
  background:#F1F5F9; color:#64748B; font-size:26rpx;
}
.dim-chip-active {
  background:#EEF2FF; color:#4F46E5; font-weight:600;
}
.scenario-input {
  width:100%; min-height:140rpx; box-sizing:border-box;
  background:#F8FAFC; border:2rpx solid #E2E8F0; border-radius:16rpx;
  padding:20rpx; font-size:28rpx; color:#1E293B; line-height:1.5;
}
.hint {
  margin-top:8rpx; font-size:24rpx; color:#94A3B8;
}

.btn-primary {
  background:#4F46E5; color:#fff; border-radius:16rpx;
  margin-top:16rpx;
}

.error-text { color:#EF4444; font-size:26rpx; padding:16rpx 0; }
.preview { background:#fff; border-radius:16rpx; padding:32rpx; margin-top:24rpx; }
.preview-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:20rpx; }
.preview-title { font-size:30rpx; font-weight:600; color:#475569; }
.copy-btn { margin:0; color:#4F46E5; border:1rpx solid #C7D2FE; background:#EEF2FF; }
.preview-content {
  display:block;
  white-space:pre-wrap;
  font-size:26rpx;
  line-height:1.8;
  color:#334155;
  padding:24rpx;
  background:#F8FAFC;
  border-radius:12rpx;
}
