<!-- pages/teacher/generate/generate.wxml — 教师生成操作单 -->
<view class="container">
  <view class="header">📚 生成操作单</view>

  <!-- 年龄段 -->
  <view class="field">
    <text class="label">年龄段</text>
    <picker bindchange="onAgeChange" value="{{ageIndex}}" range="{{ageLabels}}">
      <view class="picker-value">{{ageLabels[ageIndex]}}</view>
    </picker>
  </view>

  <!-- 难度 -->
  <view class="field">
    <text class="label">难度</text>
    <slider min="1" max="5" step="1" value="{{difficulty}}" show-value bindchange="onDifficultyChange" activeColor="#4F46E5" />
  </view>

  <!-- 维度选择 -->
  <view class="field">
    <text class="label">练习维度</text>
    <view class="dim-grid">
      <view
        class="dim-chip {{selectedDims.indexOf(item.key) >= 0 ? 'dim-chip-active' : ''}}"
        wx:for="{{dimOptions}}"
        wx:key="key"
        data-dim="{{item.key}}"
        bindtap="onDimToggle"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 活动情境描述（选填） -->
  <view class="field">
    <text class="label">💡 活动情境（选填）</text>
    <textarea
      class="scenario-input"
      value="{{scenario}}"
      bindinput="onScenarioInput"
      maxlength="300"
      placeholder="描述活动情境，如：春游时小兔分萝卜、超市购物找零、母亲节送花… 填写后 AI 生成贴合情境的操作单"
    ></textarea>
    <view class="hint">{{scenario.length}}/300 · 留空则生成标准情境操作单</view>
  </view>

  <!-- 生成按钮 -->
  <button class="btn-primary" bindtap="generate" loading="{{generating}}" disabled="{{generating}}">
    {{generating ? (scenario ? 'AI 情境化生成中...' : '生成中...') : '✨ 生成操作单'}}
  </button>

  <!-- 错误 -->
  <view class="error-text" wx:if="{{error}}">❌ {{error}}</view>

  <!-- 使用原生文本预览，兼容微信小程序渲染环境 -->
  <view class="preview" wx:if="{{previewText}}">
    <view class="preview-head">
      <view class="preview-title">📋 操作单预览</view>
      <button class="copy-btn" size="mini" bindtap="copyPreview">复制</button>
      <button class="pdf-btn" size="mini" bindtap="exportPdf" loading="{{exporting}}" disabled="{{exporting}}">{{exporting ? '导出中...' : '导出 PDF'}}</button>
    </view>
    <text class="preview-content" user-select>{{previewText}}</text>
  </view>
</view>
