<!-- pages/teacher/child-detail/child-detail.wxml — 教师查看幼儿详情 -->
<view class="container">
  <!-- Loading -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- Error -->
  <view class="error-card" wx:elif="{{error}}">
    <view class="empty-icon">📡</view>
    <view class="empty-text">{{error}}</view>
  </view>

  <!-- Content -->
  <block wx:else>
    <!-- 幼儿信息卡 -->
    <view class="info-card">
      <view class="header">👶 {{child.name}}</view>
      <view class="meta-row" wx:if="{{child.class_name || child.age_group}}">
        {{child.class_name}} {{child.age_group}}
      </view>
      <view class="meta-row" wx:if="{{child.birth_date}}">🎂 {{child.birth_date}}</view>
      <view class="meta-row notes" wx:if="{{child.notes}}">📝 {{child.notes}}</view>

      <!-- 家长访问码 -->
      <view class="access-code-box" wx:if="{{child.access_code}}" bindtap="copyAccessCode">
        <view class="code-label">家长访问码（点击复制）</view>
        <view class="code-value">{{child.access_code}} 📋</view>
      </view>

      <!-- 操作 -->
      <view class="action-row">
        <button class="btn-edit" bindtap="onEdit">✏️ 编辑</button>
        <button class="btn-delete" bindtap="onDelete">🗑 删除</button>
      </view>
    </view>

    <!-- 报告列表 -->
    <view class="section-title">📋 历史报告（{{reports.length}}）</view>
    <view class="empty-state" wx:if="{{reports.length === 0}}">
      <view class="empty-icon">📭</view>
      <view class="empty-title">暂无分析数据</view>
      <view class="empty-hint">对该幼儿拍照分析后，报告将出现在这里</view>
    </view>

    <view class="report-item" wx:for="{{reports}}" wx:key="id" data-id="{{item.id}}" bindtap="goReport">
      <view class="report-header">
        <text class="report-type">{{item.type}}</text>
        <text class="report-date">{{item.date}}</text>
      </view>
      <view class="report-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
      <view class="report-arrow">→</view>
    </view>
  </block>
</view>
