<!-- pages/teacher/child-detail/child-detail.wxml — 教师查看幼儿详情 -->
<view class="container">
  <!-- Loading -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- Error -->
  <view class="error-card" wx:elif="{{error}}">
    <view class="empty-icon">📡</view>
    <view class="empty-text">{{error}}</view>
  </view>

  <!-- Content -->
  <block wx:else>
    <view class="header">👶 {{child.name}}</view>
    <view class="meta" wx:if="{{child.class_name || child.age_group}}">
      {{child.class_name}} {{child.age_group}}
    </view>

    <view class="report" wx:if="{{report}}">
      <view class="section-title">📋 最新报告</view>
      <view class="text">{{report.overall_summary}}</view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-icon">📭</view>
      <view class="empty-title">暂无分析数据</view>
      <view class="empty-hint">对该幼儿拍照分析后，报告将出现在这里</view>
    </view>
  </block>
</view>
