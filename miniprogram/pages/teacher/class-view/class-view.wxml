<!-- pages/teacher/class-view/class-view.wxml — 教师班级概览 -->
<view class="container">
  <!-- Loading -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- Error -->
  <view class="error-card" wx:elif="{{error}}">
    <view class="empty-icon">📡</view>
    <view class="empty-text">{{error}}</view>
  </view>

  <!-- Empty -->
  <view class="empty-state" wx:elif="{{children.length === 0}}">
    <view class="empty-icon">📭</view>
    <view class="empty-title">暂无幼儿</view>
    <view class="empty-hint">请先添加幼儿信息</view>
  </view>

  <!-- List -->
  <block wx:else>
    <view class="header">🏫 班级概览（{{children.length}}人）</view>
    <view class="child-item" wx:for="{{children}}" wx:key="id" bindtap="goChild" data-id="{{item.id}}">
      <view class="child-name">👶 {{item.name}}</view>
      <view class="child-meta">{{item.class_name || ''}} · {{item.age_group}}</view>
    </view>
  </block>

  <view class="action-row">
    <button class="btn-primary" bindtap="goCapture">📸 拍照分析</button>
    <button class="btn-secondary" bindtap="goGenerate">📚 生成操作单</button>
  </view>
  <button class="btn-add" bindtap="goAddChild">＋ 添加幼儿</button>
</view>
