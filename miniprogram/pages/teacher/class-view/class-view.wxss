.container { padding:40rpx; }
.header { font-size:36rpx; font-weight:700; margin-bottom:24rpx; }
.child-item { background:#fff; border-radius:16rpx; padding:32rpx; margin-bottom:12rpx; }
.child-name { font-size:30rpx; font-weight:600; color:#1E293B; }
.child-meta { font-size:24rpx; color:#94A3B8; margin-top:4rpx; }
.btn { margin:40rpx 0; background:#4F46E5; color:#fff; border-radius:16rpx; }

/* 操作按钮并排 */
.action-row { display:flex; gap:16rpx; margin-top:24rpx; }
.action-row button { flex:1; }
.btn-primary { background:#4F46E5; color:#fff; border-radius:16rpx; }
.btn-secondary { background:#fff; color:#4F46E5; border:2rpx solid #4F46E5; border-radius:16rpx; }
.btn-add {
  margin-top:16rpx; background:#F1F5F9; color:#4F46E5;
  border:2rpx dashed #4F46E5; border-radius:16rpx; font-size:28rpx;
}
