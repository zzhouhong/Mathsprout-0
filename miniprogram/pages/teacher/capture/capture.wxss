.container { padding:40rpx; }
.header { font-size:36rpx; font-weight:700; margin-bottom:24rpx; }
.preview { margin-bottom:24rpx; border-radius:16rpx; overflow:hidden; }
.btn { margin-bottom:16rpx; }
.btn-primary { background:#4F46E5; color:#fff; border-radius:16rpx; }
.result { background:#fff; border-radius:16rpx; padding:32rpx; margin-top:24rpx; }
.score { font-size:28rpx; color:#475569; padding:12rpx 0; border-bottom:1rpx solid #F1F5F9; }
