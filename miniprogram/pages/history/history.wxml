<!-- pages/history/history.wxml — 报告历史列表 -->
<view class="container">
  <!-- Loading -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-text">加载记录中...</view>
  </view>

  <!-- Error -->
  <view class="error-card" wx:elif="{{error}}">
    <view class="empty-icon">📡</view>
    <view class="empty-text">{{error}}</view>
  </view>

  <!-- Empty -->
  <view class="empty-state" wx:elif="{{reports.length === 0}}">
    <view class="empty-icon">📭</view>
    <view class="empty-title">暂无历史记录</view>
    <view class="empty-hint">老师完成操作单分析后，记录将显示在这里</view>
  </view>

  <!-- List -->
  <block wx:else>
    <view class="header-title">📋 历史记录</view>
    <view class="list">
      <view class="item" wx:for="{{reports}}" wx:key="report_id" bindtap="goDetail" data-id="{{item.report_id}}">
        <view class="item-date">{{item.generated_at}}</view>
        <view class="item-summary">{{item.summary || '暂无摘要'}}</view>
        <view class="item-type">{{item.type === 'parent' ? '👨‍👩‍👧 家长版' : '📋 教师版'}}</view>
      </view>
    </view>
  </block>
</view>
