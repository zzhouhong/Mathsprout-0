.container { padding:40rpx; background:#F8FAFC; min-height:100vh; }
.header { margin-bottom:32rpx; }
.greeting { font-size:40rpx; font-weight:700; color:#1E293B; }
.summary-card { background:#fff; border-radius:24rpx; padding:40rpx; margin-bottom:24rpx; box-shadow:0 4rpx 24rpx rgba(0,0,0,0.04); }
.date { font-size:24rpx; color:#94A3B8; margin-bottom:16rpx; }
.summary-text { font-size:28rpx; color:#475569; line-height:1.6; margin-bottom:24rpx; }
.section-title { font-size:30rpx; font-weight:600; color:#1E293B; margin-bottom:16rpx; }
.tag-list { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:24rpx; }
.tag { padding:8rpx 20rpx; border-radius:32rpx; font-size:24rpx; }
.tag-green { background:#D1FAE5; color:#065F46; }
.activity-item { background:#F1F5F9; border-radius:12rpx; padding:20rpx; margin-bottom:12rpx; }
.act-title { font-size:26rpx; font-weight:600; color:#334155; margin-bottom:6rpx; }
.act-desc { font-size:24rpx; color:#64748B; }
.btn-outline { width:100%; height:80rpx; background:#fff; color:#4F46E5; border:2rpx solid #4F46E5; border-radius:16rpx; font-size:28rpx; display:flex; align-items:center; justify-content:center; margin-top:16rpx; }
.empty-card { background:#fff; border-radius:24rpx; padding:60rpx 40rpx; text-align:center; }
.empty-icon { font-size:80rpx; margin-bottom:20rpx; }
.empty-text { font-size:30rpx; color:#94A3B8; }
.empty-hint { font-size:24rpx; color:#CBD5E1; margin-top:8rpx; }
.trend-card { background:#fff; border-radius:24rpx; padding:40rpx; box-shadow:0 4rpx 24rpx rgba(0,0,0,0.04); }
.trend-item { display:flex; justify-content:space-between; padding:16rpx 0; border-bottom:1rpx solid #F1F5F9; }
.trend-dim { font-size:28rpx; color:#475569; }
.trend-arrow { font-size:32rpx; }

/* 切换/解绑 */
.switch-row { display:flex; justify-content:center; gap:48rpx; padding:40rpx 0; }
.switch-link { font-size:26rpx; color:#64748B; }
.switch-unbind { color:#94A3B8; }
