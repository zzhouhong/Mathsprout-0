.container { padding:40rpx; background:#F8FAFC; min-height:100vh; }
.header { font-size:36rpx; font-weight:700; margin-bottom:24rpx; }
.section { background:#fff; border-radius:20rpx; padding:32rpx; margin-bottom:20rpx; }
.section-title { font-size:30rpx; font-weight:600; color:#1E293B; margin-bottom:16rpx; }
.text { font-size:28rpx; color:#475569; line-height:1.7; }
.strength-item, .grow-item { padding:16rpx 0; border-bottom:1rpx solid #F1F5F9; }
.s-name { font-size:28rpx; font-weight:600; color:#334155; }
.s-desc { font-size:26rpx; color:#64748B; margin-top:6rpx; }
.act-item { background:#F1F5F9; border-radius:12rpx; padding:20rpx; margin-bottom:12rpx; }
.act-title { font-size:26rpx; font-weight:600; color:#334155; margin-bottom:8rpx; }
.act-line { font-size:24rpx; color:#64748B; margin-bottom:4rpx; }
.tip { background:#FEF3C7; }
.warning { background:#FFFBEB; }
.reflection { background:#EEF2FF; }
.dimension-item { padding:20rpx 0; border-bottom:1rpx solid #F1F5F9; }
.dimension-item:last-child { border-bottom:none; }
.dimension-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:14rpx; gap:16rpx; }
.dimension-name { font-size:28rpx; font-weight:600; color:#334155; }
.dimension-level { font-size:23rpx; color:#6366F1; white-space:nowrap; }
.dimension-note { font-size:24rpx; color:#64748B; line-height:1.6; margin-top:12rpx; }
.recommendation { color:#047857; }
.list-item { font-size:26rpx; color:#475569; line-height:1.7; margin-bottom:12rpx; }
.suggestion-item { padding:20rpx 0; border-bottom:1rpx solid #F1F5F9; }
.suggestion-item:last-child { border-bottom:none; }
.activity-list { margin-top:10rpx; padding:14rpx 18rpx; background:#F8FAFC; border-radius:12rpx; }
.activity-line { font-size:24rpx; color:#64748B; line-height:1.7; }
