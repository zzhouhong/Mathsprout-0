# ═══════════════════════════════════════════════════════════════════
# 萌芽助手 Mathsprout — 环境变量模板
# 复制此文件为 .env 并填入真实值
# ═══════════════════════════════════════════════════════════════════

DEBUG=false
ENVIRONMENT=development

# ─── 数据库 ───────────────────────────────────────────────────────
# 开发环境用 SQLite（默认）
DATABASE_URL=sqlite+aiosqlite:///./mathsprout.db
DATABASE_URL_SYNC=sqlite:///./mathsprout.db

# 生产环境用 PostgreSQL（Docker Compose 中自动配置）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mathsprout
# DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/mathsprout

# ─── AI Vision API ────────────────────────────────────────────────
# 提供商选择（三选一）：
#   VISION_PROVIDER=offline  → 离线模式：从 OFFLINE_RESULTS_DIR 读预存识别结果，零 API 依赖（开箱即用，适合开发/演示）
#   VISION_PROVIDER=qwen     → 阿里云百炼 Qwen-VL（推荐国内使用，需 VISION_API_KEY）
#   VISION_PROVIDER=claude   → Anthropic Claude Vision（需 ANTHROPIC_API_KEY）
#   留空 → 按 VISION_BASE_URL 自动检测（含 anthropic.com/claude 走 Claude，否则走 OpenAI 兼容）
# 详见 docs/VISION_PROVIDER.md
VISION_PROVIDER=offline
OFFLINE_RESULTS_DIR=./tests/images/golden

# 方案 A: 阿里云百炼 Qwen-VL（推荐国内使用）
#   获取 Key: https://bailian.console.aliyun.com/ → 模型广场 → 开通 Qwen-VL
VISION_API_KEY=你的阿里云百炼_API_Key
VISION_MODEL=qwen-vl-max
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 方案 B: Anthropic Claude Vision API
# VISION_API_KEY=sk-ant-你的Anthropic_Key
# VISION_MODEL=claude-sonnet-4-6
# VISION_BASE_URL=https://api.anthropic.com

# ─── 安全 ─────────────────────────────────────────────────────────
# ⚠️ 生产部署前必须生成随机密钥，切勿使用默认值（否则可伪造 teacher/admin token）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=在此填入随机生成的64位十六进制字符串

# ─── CORS — 仅前端跨域直连时生效 ──────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
